# Copy to .env.local for local development. Never commit .env.local.
# Public: this value is embedded in the browser bundle, so it must never contain secrets.

# Base URL of the Express API, without a trailing slash.
#   Local:      http://localhost:4000
#   Production: https://<your-render-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

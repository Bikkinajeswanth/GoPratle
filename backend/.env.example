# Copy to .env and fill in real values. Never commit .env.
# Every value below is a placeholder.

# development | production | test
NODE_ENV=development

# Port the API listens on locally (Render injects its own PORT automatically)
PORT=4000

# MongoDB connection string (secret). Atlas → Connect → Drivers. Either format works:
#   Standard: mongodb://<db-user>:<db-password>@<host-1>:27017,<host-2>:27017,<host-3>:27017/?ssl=true&replicaSet=<replica-set>&authSource=admin
#   SRV:      mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
#   Local:    mongodb://127.0.0.1:27017
# URL-encode special characters in the password.
MONGODB_URI=mongodb://<db-user>:<db-password>@<host-1>:27017,<host-2>:27017,<host-3>:27017/?ssl=true&replicaSet=<replica-set>&authSource=admin

# Database the app uses (optional, default: gopratle). Always wins over any
# database path in MONGODB_URI; the URI's authSource is not affected.
MONGODB_DB_NAME=gopratle

# Allowed browser origin(s) for CORS, comma-separated, no trailing slash.
# Required in production, e.g. https://<your-app>.vercel.app
FRONTEND_URL=http://localhost:3000
